   "source": [
    "* 62 Unique Path"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f3f89e2a",
   "metadata": {},
   "outputs": [],
   "source": [
    "* time comlexity: O(m*n)\n",
    "* space complexity: O(n)\n",
    "class Solution:\n",
    "    def uniquePaths(self, m: int, n: int) -> int:\n",
    "        dp = [1] * n\n",
    "        for _ in range(1, m):\n",
    "            for i in range(1, n):\n",
    "                dp[i] = dp[i] + dp[i - 1]\n",
    "        return dp[-1]"
   ]
  }
 ],
